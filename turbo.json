{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "PORT",
    "VITE_WS_URL",
    "VITE_DEV_SERVER_URL",
    "ELECTRON_RENDERER_PORT",
    "NUNCIO_HOME",
    "NUNCIO_DESKTOP_WS_URL",
    "NUNCIO_BROWSER_USE_PIPE_PATH",
    "NUNCIO_BROWSER_PERF",
    "NUNCIO_PROVIDER_RUNTIME_IDLE_STOP_MS",
    "NUNCIO_GROK_ACP_DEBUG",
    "NUNCIO_WEB_SOURCEMAP",
    "NUNCIO_SERVER_SOURCEMAP",
    "NUNCIO_DESKTOP_SOURCEMAP",
    "NUNCIO_MODE",
    "NUNCIO_PORT",
    "NUNCIO_NO_BROWSER",
    "NUNCIO_AUTH_TOKEN",
    "NUNCIO_PUBLIC_URL",
    "NUNCIO_ALLOW_INSECURE_REMOTE",
    "NUNCIO_LOG_WS_EVENTS",
    "NUNCIO_HOST",
    "NUNCIO_AUTO_BOOTSTRAP_PROJECT_FROM_CWD"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "dist-electron/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": [],
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    }
  }
}
